{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/esumit-github/cataloga-cbom/schemas/cataloga-schema-v0.9.json",
  "title": "CATALOGA 1.0 (draft 0.9) — Normative CBOM record",
  "description": "Superset of CycloneDX 1.7 CBOM (ECMA-424). Implements the C1-C9 minimum-elements model from the CATALOGA paper (Section 3). Adds four EXT namespaces: systemContext (C5), qvClassification (C6), locationProvenance (C4), canonicalKey (C9).",
  "type": "object",
  "required": ["bomFormat", "specVersion", "components"],
  "properties": {
    "bomFormat": {
      "type": "string",
      "const": "CycloneDX"
    },
    "specVersion": {
      "type": "string",
      "enum": ["1.5", "1.6", "1.7"]
    },
    "serialNumber": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "metadata": {
      "type": "object",
      "required": ["timestamp", "tools"],
      "properties": {
        "timestamp": { "type": "string" },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "component": {
          "type": "object",
          "required": ["type", "bom-ref", "name"],
          "properties": {
            "type": { "type": "string" },
            "bom-ref": { "type": "string" },
            "name": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "systemContext": {
      "$ref": "#/$defs/systemContext"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cryptoAsset" }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "dependsOn"],
        "properties": {
          "ref": { "type": "string" },
          "dependsOn": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "vulnerabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bom-ref", "id"],
        "properties": {
          "bom-ref": { "type": "string" },
          "id": { "type": "string" },
          "analysis": {
            "type": "object",
            "properties": {
              "state": { "type": "string" },
              "detail": { "type": "string" },
              "remediation": {
                "type": "object",
                "properties": {
                  "recommendation": { "type": "string" },
                  "priority": { "type": "string" },
                  "window": { "type": "string" }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "systemContext": {
      "type": "object",
      "description": "C5 — system context and criticality. Mandatory for enterprise systems, conditional for tactical.",
      "required": ["systemClass", "criticality"],
      "properties": {
        "systemClass": {
          "type": "string",
          "enum": ["enterprise", "cloud", "telecom", "ot", "tactical", "dil"]
        },
        "criticality": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"]
        },
        "boundary": { "type": "string" },
        "migrationWindow": { "type": "string" }
      },
      "additionalProperties": true
    },
    "cryptoAsset": {
      "type": "object",
      "description": "A cryptographic asset. Requires C1 identity, C3 classification, C6 QV classification, C7 lifecycle state, C9 canonical identity, and C4 provenance.",
      "required": [
        "type",
        "bom-ref",
        "name",
        "cryptoProperties",
        "qvClassification",
        "locationProvenance",
        "canonicalKey",
        "lifecycleState"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "cryptographic-asset"
        },
        "bom-ref": { "type": "string" },
        "name": { "type": "string" },
        "cryptoProperties": {
          "type": "object",
          "required": ["assetType"],
          "properties": {
            "assetType": {
              "type": "string",
              "enum": ["algorithm", "key", "certificate", "protocol", "hardware-root-of-trust", "tactical-module"]
            },
            "algorithmProperties": {
              "type": "object",
              "required": ["algorithmFamily", "algorithm"],
              "properties": {
                "algorithmFamily": { "type": "string" },
                "algorithm": { "type": "string" },
                "parameterSetIdentifier": { "type": "string" },
                "securityLevel": { "type": "integer" },
                "keyLifecycle": { "type": "string" }
              },
              "additionalProperties": true
            },
            "usage": { "type": "string" },
            "agility": {
              "type": "object",
              "description": "C8 — crypto-agility attributes (conditional, aligns with CycloneDX PR #947).",
              "properties": {
                "configurationSource": {
                  "type": "string",
                  "enum": ["hardcoded", "env-var", "config-file", "central-config", "negotiated"]
                },
                "changeMechanism": {
                  "type": "string",
                  "enum": ["not-possible", "rebuild", "restart", "runtime-config"]
                }
              },
              "additionalProperties": true
            },
            "certificateProperties": {
              "type": "object",
              "properties": {
                "issuer": { "type": "string" },
                "subject": { "type": "string" },
                "notValidAfter": { "type": "string" },
                "renewal": {
                  "type": "object",
                  "properties": {
                    "mechanism": { "type": "string" },
                    "renewBeforeDays": { "type": "integer" }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "qvClassification": {
          "type": "string",
          "description": "C6 — quantum-vulnerability classification per NIST IR 8547 timeframes.",
          "enum": ["classical-112", "classical-128+", "PQC-ready", "hybrid", "unknown"]
        },
        "locationProvenance": {
          "type": "object",
          "description": "C4 — location and provenance.",
          "required": ["method", "confidence", "timestamp"],
          "properties": {
            "method": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "timestamp": { "type": "string" }
          },
          "additionalProperties": true
        },
        "canonicalKey": {
          "type": "string",
          "description": "C9 — canonical deduplication identity.",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "lifecycleState": {
          "type": "string",
          "description": "C7 — NIST SP 800-57 key lifecycle state.",
          "enum": ["generated", "pre-activation", "active", "suspended", "compromised", "deactivated", "destroyed"]
        },
        "relationship": {
          "type": "object",
          "description": "C9 — hierarchy link (parent) and merge group.",
          "properties": {
            "parent": { "type": "string" },
            "canonicalKey": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}